{
  "name": "pinillafitness",
  "version": "0.1.0",
  "description": "A daily lift-or-stretch check-in with guided stretch timers, a calendar, and a 10 PM reminder.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "oxlint --fix --quiet; oxlint --fix --quiet; prettier --write --log-level warn . && oxlint",
    "check-format": "oxlint && prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1"
  }
}
