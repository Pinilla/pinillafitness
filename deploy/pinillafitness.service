[Unit]
Description=pinillafitness, the daily lift-or-stretch check-in
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pinillafitness
Group=pinillafitness
WorkingDirectory=/opt/pinillafitness
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3400
Environment=TZ=America/Chicago
Environment=FITNESS_DATA=/var/lib/pinillafitness
EnvironmentFile=/etc/pinillafitness.env
ExecStart=/opt/node/bin/node src/server.ts
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pinillafitness

[Install]
WantedBy=multi-user.target
